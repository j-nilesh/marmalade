# ==============================================================================
# Sprout Core — Local Family Installation Environment Configuration
# ==============================================================================
# Copy this file to .env before starting:
#   cp .env.example .env
#
# IMPORTANT:
# - Sprout Core runs strictly on your private family network or localhost.
# - DO NOT expose this port directly to the public internet without HTTPS/VPN.
# - No personal child data or conversations are sent to Sprout maintainers.
# ==============================================================================

# Server Network Configuration
SPROUT_PORT=4120
# Default: 127.0.0.1 for local-only, or 0.0.0.0 so your child's MacBook on the same home Wi-Fi can connect
SPROUT_HOST=0.0.0.0

# Persistent SQLite Database Location
SPROUT_DB_PATH=./data/sprout.db

# ------------------------------------------------------------------------------
# Provider Configuration (Optional — Can also be configured in Parent Dashboard UI)
# ------------------------------------------------------------------------------

# 1. Google Gemini (both roles are independently configurable and generation-tested)
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-3.8-flash
# Legacy variable name: true records parental review of cloud data handling, not verified ZDR.
GEMINI_ZDR_APPROVED=false

# 2. Local Model via Ollama on Mac Studio / Local Machine
# Ollama must be running ('ollama serve')
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# 2. Commercial Model via OpenAI API
# Never share this key or commit it to GitHub!
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Legacy variable name: records parental acknowledgment, not independently verified retention.
OPENAI_ZDR_APPROVED=false

# 3. Commercial Model via Anthropic API (Claude)
# Never share this key or commit it to GitHub!
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_ZDR_APPROVED=false

# 4. Pluggable Search Provider (Optional)
# Brave Search API: https://api.search.brave.com/res/v1/web/search (with SEARCH_API_KEY)
# Private SearXNG: http://127.0.0.1:8080/search or http://searxng:8080/search
# If left empty, Sprout Core automatically uses its built-in curated educational source database.
SEARCH_API_URL=
SEARCH_API_KEY=
