# ==============================================================================
# Marmalade — Family Installation Environment Configuration
# ==============================================================================
# Copy this file to .env before starting:
#   cp .env.example .env
#
# IMPORTANT:
# - Marmalade is designed for self-hosting on your private family network or private cloud.
# - DO NOT expose this port directly to the public internet without HTTPS/VPN or a reverse proxy.
# - No personal child data, telemetry, or conversation transcripts are sent to Marmalade maintainers.
# ==============================================================================

# Server Network Configuration (Legacy SPROUT_PORT / SPROUT_HOST supported as silent fallback)
MARMALADE_PORT=4120
# Default: 127.0.0.1 for local-only, or 0.0.0.0 so family devices on your home Wi-Fi can connect
MARMALADE_HOST=0.0.0.0

# Docker Host Interface Binding (used by docker-compose.yml):
# Default: 127.0.0.1 (safest default; binds to local machine only).
# Change to 0.0.0.0 to allow access from tablets and other devices across your home Wi-Fi (LAN).
MARMALADE_BIND_IP=127.0.0.1

# Persistent SQLite Database Location (Legacy SPROUT_DB_PATH supported as silent fallback)
# Default: ./data/marmalade.db (in Docker: /app/data/marmalade.db; existing sprout.db fallback is automatic)
MARMALADE_DB_PATH=./data/marmalade.db

# ------------------------------------------------------------------------------
# Security & Deployment (Optional)
# ------------------------------------------------------------------------------

# Setup Token: Required to complete first-run setup if set.
# Highly recommended when deploying to public cloud URLs (Fly, Render, Railway).
SETUP_TOKEN=

# Session Secret: Optional custom secret for signing cookies (auto-generated if omitted).
SESSION_SECRET=

# Trust Proxy: Set to true if running behind a reverse proxy (Nginx, Caddy, Cloudflare).
# When true, honors X-Forwarded-For and proxy IP headers for login rate limiting.
# (On Fly.io, proxy headers are detected automatically).
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# Provider Configuration (Optional — Can also be configured in Parent Dashboard UI)
# ------------------------------------------------------------------------------

# 1. Local Model via Ollama (100% Free & Offline)
# Ollama must be running ('ollama serve')
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# 2. Commercial Model via Anthropic API (Claude)
# Recommended for warmest conversational tone and nuanced Socratic guidance
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_ZDR_APPROVED=false

# 3. Commercial Model via OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ZDR_APPROVED=false

# 4. Pluggable Safe Web Research (Optional)
# Brave Search API: https://api.search.brave.com/res/v1/web/search (with SEARCH_API_KEY)
# Private SearXNG: http://127.0.0.1:8080/search or http://searxng:8080/search
# If left empty, Marmalade automatically uses its built-in curated educational source database.
SEARCH_API_URL=
SEARCH_API_KEY=
