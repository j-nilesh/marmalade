{
  "name": "marmalade",
  "version": "1.2.1",
  "private": true,
  "description": "Marmalade — A friendly, self-hosted AI companion and learning sanctuary for families",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/j-nilesh/marmalade.git"
  },
  "homepage": "https://github.com/j-nilesh/marmalade#readme",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "reset-password": "node scripts/reset-parent-password.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/backup.js --restore"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^11.8.1",
    "hono": "^4.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.19",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
